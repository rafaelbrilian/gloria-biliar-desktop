{
  "name": "gloria-biliard-desktop",
  "productName": "Gloria Biliard",
  "version": "2.0.2",
  "description": "Aplikasi desktop Gloria Biliard -- SELALU jalan dari salinan konten lokal (100% offline utk operasional), mengunduh pembaruan konten di latar belakang secara diam-diam (terpakai setelah restart/Muat Ulang, tak pernah mengganggu transaksi yg sedang berjalan).",
  "main": "main.js",
  "author": "Gloria Biliard",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:offline": "node scripts/build-offline-bundle.js",
    "dist": "npm run build:offline && electron-builder --win --publish never",
    "publish": "npm run build:offline && electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.gloriabiliard.desktop",
    "productName": "Gloria Biliard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "scripts/**/*",
      "offline-bundle/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gloria Biliard"
    },
    "publish": {
      "provider": "github",
      "owner": "rafaelbrilian",
      "repo": "gloria-biliar-desktop",
      "releaseType": "release"
    }
  }
}
